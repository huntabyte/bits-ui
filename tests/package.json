{
	"name": "tests",
	"description": "Tests for Bits UI components.",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"check": "pnpm sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"sync": "svelte-kit sync",
		"test": "pnpm sync && pnpm test:browser",
		"test:jsdom": "pnpm sync && vitest --project=jsdom",
		"test:browser": "pnpm sync && vitest --project=browser",
		"bench": "vitest run --project=bench",
		"bench:snapshot": "rm -rf ../packages/bits-ui/.bench-baseline && mkdir -p ../packages/bits-ui/.bench-baseline && git -C .. archive ${BENCH_REF:-HEAD} packages/bits-ui/src/lib | tar -x -C ../packages/bits-ui/.bench-baseline --strip-components=3",
		"bench:baseline": "BENCH_SRC=baseline BENCH_LABEL=${BENCH_LABEL:-baseline} vitest run --project=bench",
		"bench:compare": "node bench/compare.mjs",
		"test:src": "pnpm sync && BITS_UI_SRC=1 vitest --project=browser"
	},
	"devDependencies": {
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "^5.1.0",
		"playwright": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"bits-ui": "workspace:*"
	},
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
