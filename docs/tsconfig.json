{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "NodeNext",
		"module": "NodeNext",
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"src",
		"src/**/*.md",
		".velite/**/*",
		"other/**/*.js",
		"other/**/*.ts",
		"mdsx.config.js",
		"vite.config.ts"
	]
}
